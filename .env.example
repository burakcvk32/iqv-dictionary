# ============================================================
# IQV Dictionary — production Docker Compose configuration.
#
# Copied automatically to `.env` by scripts/windows/install.ps1 or
# scripts/linux/install.sh (Docker mode) when `.env` does not exist yet.
# Only consumed by docker-compose.prod.yml (compose-level ports / image
# build args). Per-service application secrets stay in backend/.env (see
# backend/.env.example) — never in this file.
# ============================================================

# Host port the frontend (production static build, served by nginx in
# Docker mode / the built-in static server in native mode) is published
# on. The container/native process always listens on 80/this port
# internally as well.
IQV_FRONTEND_PORT=8080

# Host port the backend API is published on. Kept in sync with
# backend/.env's PORT by the install/update scripts.
IQV_BACKEND_PORT=3001

# Baked into the frontend production build at BUILD TIME (Vite build-time
# env — see dashboard/src/utils/index.tsx, `import.meta.env.VITE_API_BASE_URL`).
# The browser calls this URL directly in production. Change this if the
# backend is reachable at a different host/port than the machine serving
# the frontend (e.g. a real domain name).
VITE_API_BASE_URL=http://localhost:3001
