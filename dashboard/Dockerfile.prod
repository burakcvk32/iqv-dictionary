# ============================================================
# IQV Dictionary dashboard (frontend) — PRODUCTION image.
#
# Multi-stage build: pnpm install + the project's own production build
# (package.json "build": "tsc && vite build") happen in a throwaway
# `builder` stage; only the static bundle (dist/) ships in the final
# image, served by nginx. Unlike ./Dockerfile (kept as-is — it backs the
# existing hot-reload docker-compose.yml dev workflow), this image NEVER
# runs `pnpm run dev` / the Vite dev server as the production solution.
#
# VITE_API_BASE_URL is a Vite BUILD-TIME env var (see
# dashboard/src/utils/index.tsx, `import.meta.env.VITE_API_BASE_URL`) —
# it gets baked into the static JS bundle, so it is supplied as a build
# ARG (docker-compose.prod.yml `build.args`), not a container runtime
# env var. Defaults to the same value dashboard/.env.example documents.
#
# Used by docker-compose.prod.yml (scripts/windows/install.ps1 and
# scripts/linux/install.sh, `-Mode docker`).
# ============================================================

FROM node:20-alpine AS builder
WORKDIR /app

# Same package manager as the dev docker-compose.yml — pnpm is the real
# source of truth (pnpm-lock.yaml, package.json
# "packageManager": "pnpm@9.15.9").
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_API_BASE_URL=http://localhost:3001
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN pnpm run build

# ---- production runtime ----
FROM nginx:1.27-alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Real, existing frontend build output served as static files — no UI/
# business logic change (dashboard/src is untouched by this Dockerfile).
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
